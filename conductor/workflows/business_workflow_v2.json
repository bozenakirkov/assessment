{
  "name": "business_workflow_v2",
  "description": "Validation and processing workflow using Conductor",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "example@email.com",
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "inputParameters": ["reference", "payload"],
  "inputTemplate": {},
  "outputParameters": {
    "validationResult": "${validate_payload.output}",
    "processingResult": "${process_payload.output}"
  },
  "tasks": [
    {
      "name": "validate_payload",
      "taskReferenceName": "validate_payload",
      "type": "SIMPLE",
      "startDelay": 0,
      "optional": false,
      "asyncComplete": false,
      "permissive": false,
      "inputParameters": {
        "reference": "${workflow.input.reference}",
        "payload": "${workflow.input.payload}"
      }
    },
    {
      "name": "process_payload",
      "taskReferenceName": "process_payload",
      "type": "SIMPLE",
      "startDelay": 0,
      "optional": false,
      "asyncComplete": false,
      "permissive": false,
      "inputParameters": {
        "reference": "${workflow.input.reference}",
        "payload": "${workflow.input.payload}",
        "validationOutput": "${validate_payload.output}"
      }
    }
  ],
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "enforceSchema": true
}