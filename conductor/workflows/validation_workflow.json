{
  "name": "validation_workflow",
  "description": "Validate workflow payload using Conductor",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "example@email.com",
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "inputParameters": ["reference", "payload"],
  "inputTemplate": {},
  "outputParameters": {
    "validationResult": "${validate_payload.output}"
  },
  "tasks": [
    {
      "name": "validate_payload",
      "taskReferenceName": "validate_payload",
      "type": "SIMPLE",
      "startDelay": 0,
      "optional": false,
      "asyncComplete": false,
      "permissive": false,
      "inputParameters": {
        "reference": "${workflow.input.reference}",
        "payload": "${workflow.input.payload}"
      }
    }
  ],
  "timeoutSeconds": 0,
  "timeoutPolicy": "ALERT_ONLY",
  "enforceSchema": true
}